# Copy to .env and fill in. .env is gitignored.

# --- Fabric / Power BI ---
# Entra tenant ID for the Fabric tenant.
SEMDOC_TENANT_ID=

# Target semantic model.
SEMDOC_WORKSPACE=
SEMDOC_SEMANTIC_MODEL=

# --- Auth: service principal (optional) ---
# Leave both blank to use interactive device-code login as yourself.
# Requires the tenant setting "Service principals can use Fabric APIs".
SEMDOC_CLIENT_ID=
SEMDOC_CLIENT_SECRET=

# --- Warehouse pass (optional) ---
# SQL analytics endpoint of the Fabric warehouse behind the model.
SEMDOC_WAREHOUSE_SERVER=
SEMDOC_WAREHOUSE_DATABASE=

# --- Enrichment ---
ANTHROPIC_API_KEY=

# Model for the narrative enrichment pass.
SEMDOC_ENRICH_MODEL=claude-sonnet-5
